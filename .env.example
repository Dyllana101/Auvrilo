# Optional local/hosted overrides. A normal local install does not need a .env file.
# When omitted, server keys are generated in the Git-ignored instance/keys.json file.
# For a hosted install, prefer your host's secret manager for these values.
# AUVRILO_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# AUVRILO_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
# AUVRILO_SETUP_KEY=replace-with-a-random-one-time-setup-code-override
# AUVRILO_KEY_FILE=instance/keys.json

AUVRILO_DATABASE_PATH=instance/auvrilo.sqlite
AUVRILO_PUBLIC_BASE_URL=http://localhost:5000
AUVRILO_COOKIE_SECURE=false
AUVRILO_TRUSTED_HOSTS=localhost,127.0.0.1
AUVRILO_ENV=development
